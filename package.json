{
  "name": "session-explorer",
  "version": "0.1.0",
  "description": "Replay Claude Code sessions, find where the tokens went, and see which pull requests they shipped.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=23.6" },
  "scripts": {
    "test": "node --test '*/*.test.ts'",
    "build": "node session-explorer/build.ts",
    "waste": "node session-explorer/build.ts --waste",
    "serve": "node session-explorer/build.ts --serve",
    "trace": "node context-tracer/tracer.ts",
    "heartbeat": "node hook-heartbeat/heartbeat.ts",
    "eval": "node eval-runner/run.ts",
    "eval:mine": "node eval-runner/mine.ts",
    "eval:diff": "node eval-runner/diff.ts",
    "eval:image": "node eval-runner/container.ts",
    "eval:matrix": "node eval-runner/matrix.ts"
  }
}
